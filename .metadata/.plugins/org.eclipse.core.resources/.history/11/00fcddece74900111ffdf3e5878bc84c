static void MX_TIM2_Init(void)
{
    TIM_OC_InitTypeDef sConfigOC = {0};

    __HAL_RCC_TIM2_CLK_ENABLE();
    __HAL_RCC_AFIO_CLK_ENABLE();

    // PB10 = TIM2_CH3
    __HAL_AFIO_REMAP_TIM2_PARTIAL_2();

    htim2.Instance = TIM2;
    htim2.Init.Prescaler = 48 - 1;          // 48 MHz / 48 = 1 MHz
    htim2.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim2.Init.Period = 1000 - 1;           // 1 kHz
    htim2.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim2.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;

    if (HAL_TIM_PWM_Init(&htim2) != HAL_OK)
    {
        Error_Handler();
    }

    sConfigOC.OCMode = TIM_OCMODE_PWM1;
    sConfigOC.Pulse = 500;                  // 50% duty
    sConfigOC.OCPolarity = TIM_OCPOLARITY_HIGH;
    sConfigOC.OCFastMode = TIM_OCFAST_DISABLE;

    if (HAL_TIM_PWM_ConfigChannel(&htim2, &sConfigOC, TIM_CHANNEL_3) != HAL_OK)
    {
        Error_Handler();
    }
}

void Servo_PulseStart(void)
{
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3);
}

void Servo_PulseStop(void)
{
    HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);

    // После остановки можно принудительно опустить PB10 в LOW
    HAL_GPIO_WritePin(SRV_PULS_CTRL_GPIO_Port, SRV_PULS_CTRL_Pin, GPIO_PIN_RESET);
}

void Servo_SetPulseFrequency(uint32_t freq_hz)
{
    if (freq_hz == 0)
    {
        Servo_PulseStop();
        return;
    }

    // TIM2 настроен на 1 MHz
    uint32_t timer_clk = 1000000UL;

    uint32_t period = timer_clk / freq_hz;

    if (period < 2)
    {
        period = 2;
    }

    __HAL_TIM_SET_AUTORELOAD(&htim2, period - 1);
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, period / 2);
    __HAL_TIM_SET_COUNTER(&htim2, 0);
}
