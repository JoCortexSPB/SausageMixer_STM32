typedef enum
{
	STATE_IDLE = 0,
	STATE_RUNNING = 1,
	STATE_ERROR = 10
} MachineState_t;

typedef enum
{
	STAGE_NOINIT = 0,
	STAGE_CYCLE = 1,
	STAGE_REWARD = 2,
	STAGE_SEEKHOME = 3
} ProgramStage_t;

float ITV_PRESSURE = 0.0f;
float REG_ITV = 0.0f;
float REG_CAROUSEL = 0.0f;
float REG_CARRIAGE = 0.0f;

uint8_t rx_cmd;
volatile uint8_t spi_cmd_ready = 0;
volatile uint8_t spi_last_cmd = 0;
volatile HAL_StatusTypeDef spi_rx_status;
volatile uint32_t spi_error_code = 0;
volatile uint32_t spi_rx_count = 0;
volatile uint32_t spi_err_count = 0;

volatile uint8_t g_state = STATE_IDLE;
volatile uint8_t g_stage = STAGE_NOINIT;
volatile uint8_t g_CarriageDirection = 0;

uint8_t HOMESENSOR = 0;
uint8_t CNTSENSOR = 0;
uint8_t NEARSENSOR = 0;
uint8_t FARSENSOR = 0;

int main(void)
{

HAL_Init();

  SystemClock_Config();

  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_RTC_Init();
  MX_SPI1_Init();
  MX_SPI2_Init();
  MX_USB_DEVICE_Init();
  MX_TIM2_Init();

  dac.hspi = &hspi1;
  dac.sync_port = AD5328_SYNC_GPIO_Port;
  dac.sync_pin = AD5328_SYNC_Pin;
  dac.ldac_port = AD5328_LDAC_GPIO_Port;
  dac.ldac_pin = AD5328_LDAC_Pin;

  dac.vref = 5.0f;
  dac.gain = 2.0f;

  AD5328_Init(&dac);

  adc.hi2c = &hi2c1;
  adc.address = ADS1115_DEFAULT_ADDR;

  adc.pga = ADS1115_PGA_6_144V;
  adc.data_rate = ADS1115_DR_128SPS;

  ADS1115_Init(&adc);

  spi_rx_status = HAL_SPI_Receive_IT(&hspi2, &rx_cmd, 1);

  Servo_SetPulseFrequency(10);
  Servo_PulseStart();

  while (1)
  {
	  ADS1115_ReadVoltageSingleEnded(&adc, ADS1115_CHANNEL_0, &ITV_PRESSURE);
	  ADS1115_ReadVoltageSingleEnded(&adc, ADS1115_CHANNEL_1, &REG_CAROUSEL);
	  ADS1115_ReadVoltageSingleEnded(&adc, ADS1115_CHANNEL_2, &REG_CARRIAGE);
	  ADS1115_ReadVoltageSingleEnded(&adc, ADS1115_CHANNEL_3, &REG_ITV);

	  AD5328_WriteABCD_Voltage(&dac,
	  		  REG_ITV * 2, REG_CAROUSEL * 2, 0.8f + REG_CARRIAGE * 2, 0.8f);

	  if(spi_cmd_ready)
	  {
		  spi_cmd_ready = 0;
		  Motherboard_ProcessCommand(spi_last_cmd);
	  }

	  if(g_state == STATE_IDLE)
	  {
		  HOMESENSOR = HAL_GPIO_ReadPin(HMSENSOR_GPIO_Port, HMSENSOR_Pin);
		  CNTSENSOR = HAL_GPIO_ReadPin(CNTSENSOR_GPIO_Port, CNTSENSOR_Pin);
		  NEARSENSOR = HAL_GPIO_ReadPin(NEARSENSOR_GPIO_Port, NEARSENSOR_Pin);
		  FARSENSOR = HAL_GPIO_ReadPin(FARSENSOR_GPIO_Port, FARSENSOR_Pin);
		  HAL_GPIO_WritePin(SRV_ON_CTRL_GPIO_Port, SRV_ON_CTRL_Pin, GPIO_PIN_RESET);

	  } else if(g_state == STATE_RUNNING)
	  {
		  HAL_GPIO_WritePin(SRV_ON_CTRL_GPIO_Port, SRV_ON_CTRL_Pin, GPIO_PIN_SET);

		  if(g_CarriageDirection == 0)
		  {
			  HAL_GPIO_WritePin(SRV_SIGN_CTRL_GPIO_Port, SRV_SIGN_CTRL_Pin, GPIO_PIN_RESET);
		  } else if(g_CarriageDirection == 1)
		  {
			  HAL_GPIO_WritePin(SRV_SIGN_CTRL_GPIO_Port, SRV_SIGN_CTRL_Pin, GPIO_PIN_SET);
		  }

		  if(g_stage == STAGE_NOINIT)
		  {

		  } else if(g_stage == STAGE_CYCLE)
		  {

		  } else if(g_stage == STAGE_REWARD)
		  {

		  } else if(g_stage == STAGE_SEEKHOME)
		  {

		  }
	  }
  }
}

void HAL_SPI_RxCpltCallback(SPI_HandleTypeDef *hspi)
{
    if (hspi->Instance == SPI2)
    {
        spi_rx_count++;

        spi_last_cmd = rx_cmd;
        spi_cmd_ready = 1;

        spi_rx_status = HAL_SPI_Receive_IT(&hspi2, &rx_cmd, 1);
    }
}

void HAL_SPI_ErrorCallback(SPI_HandleTypeDef *hspi)
{
    if (hspi->Instance == SPI2)
    {
        spi_err_count++;
        spi_error_code = HAL_SPI_GetError(hspi);

        __HAL_SPI_CLEAR_OVRFLAG(hspi);

        HAL_SPI_Abort_IT(hspi);

        spi_rx_status = HAL_SPI_Receive_IT(&hspi2, &rx_cmd, 1);
    }
}

void Motherboard_ProcessCommand(uint8_t cmd)
{
    switch (cmd)
    {
        case CMD_START:
            g_state = STATE_RUNNING;
            break;

        case CMD_STOP:
            g_state = STATE_IDLE;
            break;

        case CMD_AIR:
            // управление воздухом
            break;

        case CMD_RESET:
            // сброс
            break;

        case CMD_LEFT:
            // движение/меню влево
            break;

        case CMD_RIGHT:
            // движение/меню вправо
            break;

        case CMD_UP:
            g_CarriageDirection = 1;
            break;

        case CMD_DOWN:
        	g_CarriageDirection = 0;
            break;

        default:
            // неизвестная команда
            break;
    }
}

